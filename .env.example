# Copy this file to `.env` (which is git-ignored) and fill in your values.
# Never commit real secrets. Prefer Modal Secrets for deploys when possible.

# A Hugging Face access token (https://huggingface.co/settings/tokens).
# Needed for gated models and to avoid throttled anonymous downloads.
# app.py's _hf_secrets() uses this when no Modal Secret 'huggingface-secret' exists.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- S3 (optional) -----------------------------------------------------------
# AWS credentials for the Salad comfyui-api to read s3:// inputs and upload
# outputs (per-request `s3` block). app.py's _s3_secrets() injects these when no
# Modal Secret named 'aws-secret' exists. Bucket/prefix are chosen per request,
# not here. For S3-compatible stores (Cloudflare R2, MinIO) also set
# AWS_ENDPOINT_URL_S3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
# AWS_ENDPOINT_URL_S3=https://<accountid>.r2.cloudflarestorage.com

# --- Modal proxy auth (local GUI proxy + curl) -------------------------------
# Create at: Modal dashboard -> Settings -> Proxy Auth Tokens
# Used by scripts/gui-proxy.sh (Caddy injects these headers for localhost GUI).
MODAL_KEY=wk-xxxxxxxxxxxxxxxxxxxxxxxx
MODAL_SECRET=ws-xxxxxxxxxxxxxxxxxxxxxxxx
# Optional overrides for the local GUI proxy:
# GUI_UPSTREAM=https://larshelg--comfy-image-gui.modal.run
# GUI_PROXY_PORT=8188
